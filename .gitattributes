# Release-manifest verification depends on exact bytes on Windows and Mac.
/package/** -text
/CITATION.cff -text
/LICENSE.txt -text

# Public prose and helpers use portable LF; approved package bytes stay exact.
/*.md text eol=lf
/scripts/*.py text eol=lf
/RELEASE_MANIFEST.json text eol=lf
*.dotm binary
*.docx binary
*.pdf binary

# Repository archives include package contents only; release assets are built separately.
/* export-ignore
/package -export-ignore
/package/** -export-ignore
